# Reference only. Set these in the Coolify application environment.
# This file is not loaded automatically. Never put real secrets here.

# Upstream leads service. When set, Apache proxies /v1/lead to
# ${LEADS_SERVICE_URL}/v1/lead (or to the value as-is if it already ends in /v1/lead).
# Leave empty to serve the site without a leads proxy.
LEADS_SERVICE_URL=

# Public hostname used by scripts/setup-server.sh for the Apache vhost and certbot.
# Example: www.mbconstructionandelectric.com
SITE_DOMAIN=

# Display name for server comments and local preview. Not a secret.
SITE_NAME=MB Construction and Electric

# Canonical origin. The built pages read the canonical host from data/site.json.
# This variable is documentation for deploy configuration.
CANONICAL_HOST=https://www.mbconstructionandelectric.com
